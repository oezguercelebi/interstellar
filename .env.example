# ─────────────────────────────────────────────────────────────
# Interstellar — environment template. Copy to .env.local and fill in.
# Mirror the same values into Convex with `npx convex env set <KEY> <value>`
# (the agent + sandbox run server-side in Convex).
# ─────────────────────────────────────────────────────────────

# Anthropic — powers the coding agent. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Daytona — runs generated Expo apps + serves the live preview. https://app.daytona.io/
DAYTONA_API_KEY=dtn_...
DAYTONA_API_URL=https://app.daytona.io/api
# Pre-baked snapshot (create with: node scripts/bake-snapshot.mjs)
DAYTONA_SNAPSHOT=interstellar-studio
# Region target for custom snapshots (match your Daytona org region: eu | us).
DAYTONA_TARGET=eu

# Daytona preview-domain suffix used by the same-origin preview proxy.
# Find yours by opening any sandbox preview URL: https://8081-<id>.<suffix>
# DAYTONA_PREVIEW_SUFFIX=daytonaproxy01.eu

# Convex — filled automatically by `npx convex dev --configure`.
# CONVEX_DEPLOYMENT=dev:your-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
