# ─────────────────────────────────────────────────────────────
# Interstellar — environment template. Copy to .env.local and fill in.
# Mirror the same values into Convex with `npx convex env set <KEY> <value>`
# (the agent + sandbox run server-side in Convex).
# ─────────────────────────────────────────────────────────────

# Anthropic — powers the coding agent. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Daytona — runs generated Expo apps + serves the live preview. https://app.daytona.io/
DAYTONA_API_KEY=dtn_...
DAYTONA_API_URL=https://app.daytona.io/api
# Pre-baked snapshot (create with: node scripts/bake-snapshot.mjs). The nw1
# image is a superset — it runs BOTH starter kits (classic StyleSheet + NativeWind).
DAYTONA_SNAPSHOT=interstellar-studio-nw1
# Region target for custom snapshots (match your Daytona org region: eu | us).
DAYTONA_TARGET=eu

# Starter kit for NEW generations — Convex-side env var, set with
#   npx convex env set STARTER_KIT nativewind
# Unset (or unknown value) = classic StyleSheet kit. Rollout order for existing
# deployments (ONLY this order is safe): 1) deploy code  2) bake the snapshot
# 3) set DAYTONA_SNAPSHOT + verify a classic preview still works  4) set
# STARTER_KIT. Rollback: `npx convex env unset STARTER_KIT` — instant, new gens
# revert to classic. Versions are stamped with their kit; flips never touch them.
# STARTER_KIT=nativewind

# Daytona preview-domain suffix used by the same-origin preview proxy.
# Find yours by opening any sandbox preview URL: https://8081-<id>.<suffix>
# DAYTONA_PREVIEW_SUFFIX=daytonaproxy01.eu

# Convex — filled automatically by `npx convex dev --configure`.
# CONVEX_DEPLOYMENT=dev:your-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
