# @convex-dev/agent@0.6 declares a strict peer on ai@^6.0.35; the rest of the
# tree pins compatible-but-not-identical ranges, so npm's strict peer resolver
# errors (ERESOLVE) on a clean install. legacy-peer-deps lets the install
# proceed with the versions we've pinned (verified working). Needed for Vercel's
# clean install too.
legacy-peer-deps=true
